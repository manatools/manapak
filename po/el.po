#: manapak/__init__.py:31 manapak/ui.py:71
msgid "manapak - Flatpak updates"
msgstr "manapak - Ενημερώσεις Flatpak"

#: manapak/__init__.py:33
msgid ""
"Desktop tool to check and apply Flatpak updates via the Flatpak Python API."
msgstr ""
"Εργαλείο για την επιφάνεια εργασίας που ελέγχει και εφαρμόζει ενημερώσεις "
"Flatpak μέσω του API Python του Flatpak."

#: manapak/__init__.py:34
msgid "Manage Flatpak updates through the Flatpak Python API."
msgstr "Διαχείριση ενημερώσεων Flatpak μέσω του API Python του Flatpak."

